#!/usr/bin/python3 -I
"""Opt-in, per-game Intel RAPL PSys boost for Acer Nitro Lite 16."""
import fcntl
import os
from pathlib import Path
import select
import signal
import subprocess
import sys

MODEL_FILE = Path("/sys/devices/virtual/dmi/id/product_name")
POWERCAP = Path("/sys/class/powercap")
SUPPLY = Path("/sys/class/power_supply")
AC = SUPPLY / "ADP1/online"
BATTERY = SUPPLY / "BAT0"
ADAPTER_RATING = Path("/sys/bus/platform/devices/INTC10A4:00/dptf_power/adapter_rating_mw")
TEMPERATURES = Path("/sys/devices/platform/coretemp.0/hwmon")
STOCK_UW = 50_000_000
BOOST_UW = 70_000_000
TEMPERATURE_LIMIT_MC = 95_000
READY = "NITRO_UNLOCK_READY"
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


def message(text):
    print(f"nitro-unlock: {text}", file=sys.stderr, flush=True)


def read(path):
    return path.read_text().strip()


def number(path):
    return int(read(path))


def psys_zone():
    if read(MODEL_FILE) != "Nitro NL16-71G":
        raise RuntimeError("ожидается Acer Nitro NL16-71G")
    for zone in sorted(POWERCAP.glob("intel-rapl:[0-9]*")):
        if read(zone / "name") == "psys":
            return zone
    raise RuntimeError("домен Intel RAPL PSys недоступен")


def constraints(zone):
    paths = {}
    for title in zone.glob("constraint_*_name"):
        paths[read(title)] = title.with_name(title.name.removesuffix("_name") + "_power_limit_uw")
    if not {"long_term", "short_term"} <= paths.keys():
        raise RuntimeError("PSys PL1 и PL2 недоступны")
    return paths["short_term"], paths["long_term"]


def package_temperature():
    for label in TEMPERATURES.glob("hwmon*/temp*_label"):
        if read(label) == "Package id 0":
            return label.with_name(label.name.removesuffix("_label") + "_input")
    raise RuntimeError("датчик температуры CPU недоступен")


def write_limit(path, value):
    path.write_text(f"{value}\n")
    if number(path) != value:
        raise RuntimeError(f"ядро не подтвердило значение {value / 1e6:g} Вт для {path.name}")


def apply_limits(paths, target):
    for path in paths:
        if number(path) != target:
            write_limit(path, target)


def restore_limits(original, applied):
    errors = []
    for path, value in reversed(tuple(original.items())):
        try:
            current = number(path)
            if current == applied and current != value:
                write_limit(path, value)
            elif current != value:
                message(f"{path.name} изменился извне до {current / 1e6:g} Вт")
        except (OSError, ValueError, RuntimeError) as error:
            errors.append(f"{path.name}: {error}")
    if errors:
        raise RuntimeError("сбой возврата лимита: " + ", ".join(errors))


def watch_power(lease_fd, paths, temperature, stopping):
    poller = select.poll()
    poller.register(lease_fd, select.POLLIN | select.POLLHUP | select.POLLERR)
    while not stopping():
        if poller.poll(500):
            break
        if number(AC) != 1:
            message("адаптер отключился, возвращаю лимит")
            break
        if number(temperature) >= TEMPERATURE_LIMIT_MC:
            message("CPU достиг 95 °C, возвращаю лимит")
            break
        if any(number(path) != BOOST_UW for path in paths):
            message("PSys изменился извне, завершаю повышение лимита")
            break


def worker(restore_stock=False):
    if os.geteuid() != 0 or not any(os.environ.get(key) for key in ("SUDO_UID", "PKEXEC_UID")):
        raise RuntimeError("системная операция требует авторизации")
    zone = psys_zone()
    paths = constraints(zone)
    with (zone / "name").open() as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("другая сессия уже управляет PSys") from error
        original = {path: number(path) for path in paths}
        if restore_stock:
            try:
                apply_limits(paths, STOCK_UW)
            except (OSError, ValueError, RuntimeError):
                restore_limits(original, STOCK_UW)
                raise
            print(READY, flush=True)
            message("оба лимита PSys выставлены на 50 Вт")
            return
        if number(zone / "enabled") != 1 or number(AC) != 1:
            raise RuntimeError("для повышения нужны включённый PSys и подключённый адаптер")
        if number(ADAPTER_RATING) < 70_000:
            raise RuntimeError("номинал адаптера в данных ACPI ниже 70 Вт")
        temperature = package_temperature()
        if number(temperature) >= TEMPERATURE_LIMIT_MC:
            raise RuntimeError("CPU уже достиг 95 °C")
        if select.select([sys.stdin], [], [], 0)[0]:
            raise RuntimeError("запуск игры был отменён")

        stopped = False

        def stop(_signal, _frame):
            nonlocal stopped
            stopped = True

        for name in SIGNALS:
            signal.signal(name, stop)

        # A 70 W value left by a manual change belongs to this session.
        original = {path: STOCK_UW if value == BOOST_UW else value for path, value in original.items()}
        try:
            apply_limits(paths, BOOST_UW)
            if stopped:
                return
            print(READY, flush=True)
            message("PSys PL1 и PL2 выставлены на 70 Вт на время игры")
            watch_power(sys.stdin.fileno(), paths, temperature, lambda: stopped)
        finally:
            restore_limits(original, BOOST_UW)
            values = [number(path) / 1e6 for path in reversed(paths)]
            message(f"PSys после выхода: PL1 {values[0]:g} Вт, PL2 {values[1]:g} Вт")


def auth_command(restore_stock):
    operation = "--_restore" if restore_stock else "--_worker"
    helper = ["/usr/bin/python3", "-I", str(Path(__file__).resolve()), operation]
    if sys.stdin.isatty() or sys.stderr.isatty():
        return ["/usr/bin/pkexec", *helper]
    service = Path("/usr/lib/systemd/user/plasma-polkit-agent.service")
    if service.is_file() and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        subprocess.run(
            ["/usr/bin/systemctl", "--user", "start", "plasma-polkit-agent.service"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8, check=False,
        )
    return ["/usr/bin/pkexec", "--disable-internal-agent", *helper]


def wait_for_auth(process):
    # A graphical authorization prompt or sudo can wait for the owner's input.
    for line in process.stdout:
        if line.strip() == READY:
            return True
        print(line, end="", file=sys.stderr, flush=True)
    return False


def close_worker(process):
    process.stdin.close()
    try:
        return process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        message("не получено подтверждение возврата лимита, проверь --status")
        return 1
    finally:
        process.stdout.close()


def launch(command, restore_stock=False):
    interrupt = 0
    game = None
    privilege = None
    boosted = False
    game_result = 0

    def stop(signum, _frame):
        nonlocal interrupt
        interrupt = signum
        if game is not None and game.poll() is None:
            game.send_signal(signum)
        if privilege is not None and not privilege.stdin.closed:
            privilege.stdin.close()

    for name in SIGNALS:
        signal.signal(name, stop)
    try:
        try:
            auth = auth_command(restore_stock)
            if interrupt:
                return 128 + interrupt
            privilege = subprocess.Popen(auth, stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, text=True)
            boosted = wait_for_auth(privilege)
            if not boosted:
                if restore_stock:
                    return 1
                message("повышение не включено, запускаю игру")
        except (OSError, subprocess.TimeoutExpired) as error:
            if restore_stock:
                raise RuntimeError(f"не удалось запустить авторизацию: {error}") from error
            message(f"авторизация недоступна, запускаю игру: {error}")
        if interrupt:
            return 128 + interrupt
        if not restore_stock:
            game = subprocess.Popen(command)
            if interrupt and game.poll() is None:
                game.send_signal(interrupt)
            result = game.wait()
            game_result = result if result >= 0 else 128 - result
    finally:
        privilege_result = close_worker(privilege) if privilege is not None else 0
    return game_result or (privilege_result if boosted else 0)


def status():
    zone = psys_zone()
    short, long = constraints(zone)
    print(f"PSys PL1: {number(long) / 1e6:g} W")
    print(f"PSys PL2: {number(short) / 1e6:g} W")
    print(f"AC: {'online' if number(AC) else 'offline'}")
    print(f"AC adapter rating (ACPI): {number(ADAPTER_RATING) / 1000:g} W")
    print(f"Battery: {read(BATTERY / 'capacity')}%, {read(BATTERY / 'status')}, "
          f"{number(BATTERY / 'power_now') / 1e6:g} W")


def main(args):
    if args == ["--_worker"] or args == ["--_restore"]:
        worker(restore_stock=args == ["--_restore"])
        return 0
    if os.geteuid() == 0:
        raise RuntimeError("запускай обёртку от обычного пользователя")
    if args == ["--status"]:
        status()
        return 0
    if args == ["--restore-stock"]:
        return launch([], restore_stock=True)
    if not args or args == ["--help"] or args == ["-h"]:
        print("nitro-unlock [--] GAME [ARGUMENT …]\n"
              "nitro-unlock --status\n"
              "nitro-unlock --restore-stock")
        return 0
    if args[0] == "--":
        args = args[1:]
    if not args or args[0].startswith("-"):
        raise RuntimeError("укажи команду запуска игры или --help")
    return launch(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, RuntimeError, ValueError) as problem:
        message(problem)
        raise SystemExit(1)
